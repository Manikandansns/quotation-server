generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum QuotationStatus {
  DRAFT
  FINAL
  SENT
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotationsPrepared Quotation[] @relation("PreparedBy")
  quotationsApproved Quotation[] @relation("ApprovedBy")
  auditLogs          AuditLog[]
}

model Client {
  id            String   @id @default(cuid())
  name          String
  company       String
  address       String
  phone         String
  email         String
  gstNumber     String?
  contactPerson String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations Quotation[]

  @@index([name])
  @@index([company])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

model Material {
  id               String   @id @default(cuid())
  name             String
  materialCode     String   @unique
  unit             String
  defaultUnitPrice Decimal  @db.Decimal(12, 2)
  description      String?
  status           Boolean  @default(true)
  categoryId       String?
  stockOnHand      Decimal  @default(0) @db.Decimal(12, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       Category?          @relation(fields: [categoryId], references: [id])
  quotationItems QuotationItem[]
  movements      MaterialMovement[]

  @@index([name])
}

enum MovementType {
  INWARD
  OUTWARD
}

model MaterialMovement {
  id              String       @id @default(cuid())
  materialId      String
  type            MovementType
  quantity        Decimal      @db.Decimal(12, 3)
  reference       String?
  notes           String?
  transactionDate DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([type])
}

model Quotation {
  id               String          @id @default(cuid())
  quotationNumber  String          @unique
  status           QuotationStatus @default(DRAFT)
  date             DateTime
  vessel           String?
  vesselId         String?
  poNumber         String?
  attend           String?
  project          String?
  referenceNumber  String?
  currency         String          @default("INR")
  subtotal         Decimal         @db.Decimal(12, 2)
  packingCharges   Decimal         @default(0) @db.Decimal(12, 2)
  transportCharges Decimal         @default(0) @db.Decimal(12, 2)
  discount         Decimal         @default(0) @db.Decimal(12, 2)
  taxPercent       Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  roundOff         Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal         @db.Decimal(12, 2)
  terms            String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  clientId     String
  templateId   String?
  preparedById String?
  approvedById String?
  client       Client             @relation(fields: [clientId], references: [id])
  template     QuotationTemplate? @relation(fields: [templateId], references: [id])
  vesselRecord Vessel?            @relation(fields: [vesselId], references: [id])
  preparedBy   User?              @relation("PreparedBy", fields: [preparedById], references: [id])
  approvedBy   User?              @relation("ApprovedBy", fields: [approvedById], references: [id])
  items        QuotationItem[]
  emailLogs    EmailLog[]
  auditLogs    AuditLog[]

  @@index([date])
  @@index([referenceNumber])
  @@index([vesselId])
  @@index([templateId])
  @@index([vessel])
}

model QuotationItem {
  id          String   @id @default(cuid())
  serialNo    Int
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotationId String
  materialId  String?
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  material    Material? @relation(fields: [materialId], references: [id])

  @@index([quotationId])
}

model CompanySettings {
  id                String   @id @default(cuid())
  companyName       String
  gstNumber         String?
  email             String?
  phone             String?
  address           String?
  quotationPrefix   String   @default("QT")
  currency          String   @default("INR")
  defaultTaxPercent Decimal  @default(18) @db.Decimal(5, 2)
  defaultPacking    Decimal  @default(0) @db.Decimal(12, 2)
  defaultTransport  Decimal  @default(0) @db.Decimal(12, 2)
  logoPath          String?
  signaturePath     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model QuotationTemplate {
  id                  String   @id @default(cuid())
  templateCode        String   @unique
  templateName        String   @unique
  companyName         String   @unique
  companyRegistration String?
  gstNumber           String?
  email               String?
  phone               String?
  address             String?
  senderName          String?
  quotationHeading    String?  @default("MATERIALS & CONSUMABLES SUPPLY")
  logoPath            String?
  signaturePath       String?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quotations Quotation[]

  @@index([isDefault])
}

model Vessel {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]

  @@index([name])
}

model EmailLog {
  id          String    @id @default(cuid())
  toEmail     String
  subject     String
  body        String
  status      String
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  metadata    String?
  createdAt   DateTime @default(now())
  userId      String?
  quotationId String?

  user      User?      @relation(fields: [userId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
